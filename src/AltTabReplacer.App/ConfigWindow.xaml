<Window x:Class="AltTabReplacer.ConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:AltTabReplacer.ViewModels"
        xmlns:models="clr-namespace:AltTabReplacer.Core.Models;assembly=AltTabReplacer.Core"
        Title="AltTabReplacer — 规则配置"
        Width="780" Height="500"
        MinWidth="600" MinHeight="320"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True">
    <Window.Resources>
        <Style x:Key="ToolBtn" TargetType="Button">
            <Setter Property="MinWidth" Value="80"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="Padding" Value="10,4"/>
        </Style>
    </Window.Resources>

    <DockPanel LastChildFill="True">

        <!-- 顶部说明 + 工具栏 -->
        <Border DockPanel.Dock="Top" Background="#FF252525" Padding="12,8">
            <StackPanel>
                <TextBlock Foreground="#FFDDDDDD" FontSize="13" FontWeight="SemiBold"
                           Text="排序规则（修改即生效，下次唤起选择器时应用）"/>
                <TextBlock Foreground="#FF999999" FontSize="11" Margin="0,4,0,0"
                           Text="MatchType 选 ProcessName 时 Pattern 是 exe 文件名（如 Code.exe）；选 WindowTitle 时是标题子串；选 Regex 是完整正则。Priority 越大越靠前。"/>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button x:Name="AddBtn" Content="+ 新增" Style="{StaticResource ToolBtn}" Click="OnAddClick"/>
                    <Button x:Name="RemoveBtn" Content="- 删除" Style="{StaticResource ToolBtn}" Click="OnRemoveClick"/>
                    <Button x:Name="UpBtn" Content="↑ Priority" Style="{StaticResource ToolBtn}" Click="OnUpClick"/>
                    <Button x:Name="DownBtn" Content="↓ Priority" Style="{StaticResource ToolBtn}" Click="OnDownClick"/>
                    <Button x:Name="OpenFileBtn" Content="打开 rules.json" Style="{StaticResource ToolBtn}" Click="OnOpenFileClick" HorizontalAlignment="Right"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 底部状态条 -->
        <Border DockPanel.Dock="Bottom" Background="#FF1A1A1A" Padding="12,6">
            <DockPanel>
                <TextBlock x:Name="StatusText" Foreground="#FF999999" FontSize="11" VerticalAlignment="Center"/>
                <TextBlock HorizontalAlignment="Right" Foreground="#FF777777" FontSize="11" VerticalAlignment="Center"
                           Text="提示：双击单元格可编辑；Ctrl+Alt+R 重新打开本窗口"/>
            </DockPanel>
        </Border>

        <!-- DataGrid -->
        <DataGrid x:Name="Grid"
                  ItemsSource="{Binding Rules}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  RowHeaderWidth="0"
                  AlternationCount="2"
                  AlternatingRowBackground="#FF202020"
                  RowBackground="#FF181818"
                  Foreground="#FFDDDDDD"
                  BorderThickness="0"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Pattern" Binding="{Binding Pattern, UpdateSourceTrigger=PropertyChanged}" Width="2*" FontSize="12"/>
                <DataGridTemplateColumn Header="MatchType" Width="120" SortMemberPath="MatchType">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding MatchType}" VerticalAlignment="Center" Padding="6,0"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <ComboBox SelectedItem="{Binding MatchType, UpdateSourceTrigger=PropertyChanged}"
                                      VerticalAlignment="Center">
                                <models:MatchType>ProcessName</models:MatchType>
                                <models:MatchType>WindowTitle</models:MatchType>
                                <models:MatchType>Regex</models:MatchType>
                            </ComboBox>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Priority" Binding="{Binding Priority, UpdateSourceTrigger=PropertyChanged}" Width="80" FontSize="12"/>
                <DataGridCheckBoxColumn Header="Pinned" Binding="{Binding IsPinned, UpdateSourceTrigger=PropertyChanged}" Width="60"/>
                <DataGridCheckBoxColumn Header="Excluded" Binding="{Binding IsExcluded, UpdateSourceTrigger=PropertyChanged}" Width="70"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
