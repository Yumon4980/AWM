<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>AltTabReplacer</RootNamespace>
    <AssemblyName>AltTabReplacer</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\AWM.ico</ApplicationIcon>
    <NoWarn>$(NoWarn);CS8002</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AltTabReplacer.Core\AltTabReplacer.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Drawing.Common" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- 主题资源字典：保留为原始 XAML（不被编译成 BAML），
         让 ThemeManager 能用 pack URI 按需加载 / 替换。 -->
    <Resource Include="Themes\Dark.xaml" />
    <Resource Include="Themes\Light.xaml" />
  </ItemGroup>

</Project>
