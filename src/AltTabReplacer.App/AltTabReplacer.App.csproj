<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>AWM</RootNamespace>
    <!-- 生成程序名（不含扩展名）：最终产物为 <AssemblyName>.exe -->
    <AssemblyName>AWM</AssemblyName>
    <!-- 在文件资源管理器中显示的产品名（可选） -->
    <ProductName>AWM</ProductName>
    <AssemblyTitle>AWM</AssemblyTitle>
    <!-- 输出路径：相对 csproj 的目录。默认值是 bin\$(Configuration)\net8.0-windows\ -->
    <OutputPath>C:\01-app\AWM</OutputPath>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\AWM.ico</ApplicationIcon>
    <NoWarn>$(NoWarn);CS8002</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AltTabReplacer.Core\AltTabReplacer.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Drawing.Common" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- 主题资源字典：保留为原始 XAML（不被编译成 BAML），
         让 ThemeManager 能用 pack URI 按需加载 / 替换。 -->
    <Resource Include="Themes\Dark.xaml" />
    <Resource Include="Themes\Light.xaml" />
  </ItemGroup>

</Project>
