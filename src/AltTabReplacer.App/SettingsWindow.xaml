<Window x:Class="AltTabReplacer.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:AltTabReplacer.ViewModels"
        xmlns:models="clr-namespace:AltTabReplacer.Core.Models;assembly=AltTabReplacer.Core"
        xmlns:local="clr-namespace:AltTabReplacer"
        Title="AltTabReplacer — 设置"
        Width="760" Height="520"
        MinWidth="640" MinHeight="400"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        Background="{DynamicResource WindowBackground}"
        Foreground="{DynamicResource TextForeground}">
    <Window.Resources>
        <local:BoolToVisConverter x:Key="BoolToVis"/>
        <local:ThemeModeToTextConverter x:Key="ThemeModeToText"/>

        <!-- 通用样式：标题文字 -->
        <Style x:Key="PanelTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextForeground}"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>

        <!-- 字段标签 -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextForegroundDim}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
            <Setter Property="MinWidth" Value="80"/>
        </Style>

        <!-- 字段输入（ComboBox / TextBox 通用） -->
        <Style x:Key="FieldInput" TargetType="Control">
            <Setter Property="Background" Value="{DynamicResource InputBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextForeground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushStrong}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <!-- 字段行：标签 + 输入，垂直堆叠，每行间距 12 -->
        <Style x:Key="FieldRow" TargetType="Grid">
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- 左列：导航 -->
            <ColumnDefinition Width="200"/>
            <!-- 右列：详情 -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===== 左列：分类导航 ===== -->
        <Border Grid.Column="0"
                Background="{DynamicResource OverflowPanelBackground}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,1,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top"
                           Text="设置"
                           FontSize="14" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextForeground}"
                           Margin="20,20,20,14"/>

                <ListBox x:Name="CategoryList"
                         ItemsSource="{Binding Categories}"
                         SelectedItem="{Binding Selected, Mode=TwoWay}"
                         Background="Transparent"
                         BorderThickness="0"
                         HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="8,2"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Focusable" Value="True"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <!-- 模板对齐 SelectorWindow 的「未入网格」行：圆角、悬停高亮、选中蓝色 -->
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="RowBd"
                                                Padding="10,8"
                                                CornerRadius="4"
                                                Background="Transparent"
                                                BorderThickness="1"
                                                BorderBrush="Transparent">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="RowBd" Property="Background" Value="{DynamicResource HoverBackground}"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="RowBd" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                                <Setter TargetName="RowBd" Property="BorderBrush" Value="{DynamicResource AccentBrushLight}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Icon}"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="13"
                                           Foreground="{DynamicResource TextForeground}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,10,0"/>
                                <TextBlock Text="{Binding Title}"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextForeground}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- ===== 右列：详情面板 ===== -->
        <Border Grid.Column="1"
                Background="{DynamicResource PanelBackgroundDeep}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Padding="28,24">
                <Grid>
                    <!-- 主题面板 -->
                    <StackPanel Visibility="{Binding IsThemeSelected, Converter={StaticResource BoolToVis}}">
                        <TextBlock Style="{StaticResource PanelTitle}" Text="主题"/>

                        <Grid Style="{StaticResource FieldRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource FieldLabel}" Text="主题模式"/>
                            <ComboBox Grid.Column="1"
                                      Style="{StaticResource FieldInput}"
                                      SelectedItem="{Binding ThemeMode, Mode=TwoWay}"
                                      HorizontalAlignment="Stretch">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource ThemeModeToText}}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                                <models:ThemeMode>System</models:ThemeMode>
                                <models:ThemeMode>Light</models:ThemeMode>
                                <models:ThemeMode>Dark</models:ThemeMode>
                            </ComboBox>
                        </Grid>

                        <TextBlock Foreground="{DynamicResource TextForegroundMuted}"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,0"
                                   Text="「跟随系统主题」会读取 Windows 的深色/浅色设置，系统切换时自动跟随。"/>
                    </StackPanel>

                    <!-- 其他分类占位 -->
                    <StackPanel Visibility="{Binding IsThemeSelected, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                        <TextBlock Style="{StaticResource PanelTitle}"
                                   Text="{Binding Selected.Title}"/>
                        <TextBlock Foreground="{DynamicResource TextForegroundMuted}"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Text="该类别的详细设置面板将在后续版本中提供。"/>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>