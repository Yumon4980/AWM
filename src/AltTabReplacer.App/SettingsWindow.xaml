<Window x:Class="AltTabReplacer.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:AltTabReplacer.ViewModels"
        xmlns:models="clr-namespace:AltTabReplacer.Core.Models;assembly=AltTabReplacer.Core"
        xmlns:local="clr-namespace:AltTabReplacer"
        Title="AltTabReplacer — 设置"
        Width="760" Height="520"
        MinWidth="640" MinHeight="400"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        Background="{DynamicResource WindowBackground}"
        Foreground="{DynamicResource TextForeground}">
    <Window.Resources>
        <local:BoolToVisConverter x:Key="BoolToVis"/>
        <local:ThemeModeToTextConverter x:Key="ThemeModeToText"/>

        <!-- 通用样式：标题文字 -->
        <Style x:Key="PanelTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextForeground}"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>

        <!-- 字段标签 -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextForegroundDim}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
            <Setter Property="MinWidth" Value="80"/>
        </Style>

        <!-- 字段输入（ComboBox / TextBox 通用） -->
        <Style x:Key="FieldInput" TargetType="Control">
            <Setter Property="Background" Value="{DynamicResource InputBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextForeground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushStrong}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <!-- 字段行：标签 + 输入，垂直堆叠，每行间距 12 -->
        <Style x:Key="FieldRow" TargetType="Grid">
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <!-- 主题下拉框：WPF 默认 ComboBox 模板自带白底、不吃 Background/Foreground，
             深色模式下会变成"白底灰字"，必须整体替换模板、全部走主题画刷。 -->
        <ControlTemplate x:Key="FieldComboToggleTemplate" TargetType="ToggleButton">
            <Border x:Name="Bd"
                    Background="{DynamicResource InputBackground}"
                    BorderBrush="{DynamicResource BorderBrushStrong}"
                    BorderThickness="1"
                    CornerRadius="3">
                <Path Data="M 0 0 L 4 4 L 8 0 Z"
                      Fill="{DynamicResource TextForegroundDim}"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Center"
                      Margin="0,0,9,0"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrushLight}"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- 弹出下拉项在独立的 Popup 视觉树里，ComboBox 的 Foreground 不会自动继承，必须显式指定 -->
        <Style x:Key="FieldComboBoxItem" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource TextForeground}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="3"
                                Margin="2,1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBackground}"/>
                            </Trigger>
                            <!-- IsSelected 放在 IsHighlighted 之后：选中项常驻蓝色，悬停别的高亮不打架 -->
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FieldComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="{DynamicResource InputBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextForeground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushStrong}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <!-- 右侧留 24 给箭头，避免长文本顶到箭头 -->
            <Setter Property="Padding" Value="8,5,24,5"/>
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource FieldComboBoxItem}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False"
                                          ClickMode="Press"
                                          Template="{StaticResource FieldComboToggleTemplate}"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                            <ContentPresenter IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center"/>
                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   PopupAnimation="Fade">
                                <Border Background="{DynamicResource InputBackground}"
                                        BorderBrush="{DynamicResource BorderBrushStrong}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Margin="0,2,0,0"
                                        MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  Padding="2"
                                                  SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True"
                                                    KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 按钮字段：主题画刷，深浅两色都成立（默认按钮模板是硬编码白底） -->
        <Style x:Key="FieldButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource InputBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextForeground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushStrong}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBackground}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrushLight}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 复选框：默认模板的勾选框是硬编码白底，深色模式下突兀，整体替换 -->
        <Style x:Key="FieldCheck" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextForeground}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="Box"
                                    Width="16" Height="16"
                                    Background="{DynamicResource InputBackground}"
                                    BorderBrush="{DynamicResource BorderBrushStrong}"
                                    BorderThickness="1"
                                    CornerRadius="3"
                                    VerticalAlignment="Center">
                                <Path x:Name="Check"
                                      Data="M 3 8 L 6.5 11.5 L 13 4.5"
                                      Stroke="{DynamicResource TextForeground}"
                                      StrokeThickness="2"
                                      Visibility="Collapsed"
                                      Stretch="None"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentBrushLight}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- 左列：导航 -->
            <ColumnDefinition Width="200"/>
            <!-- 右列：详情 -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===== 左列：分类导航 ===== -->
        <Border Grid.Column="0"
                Background="{DynamicResource OverflowPanelBackground}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,1,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top"
                           Text="设置"
                           FontSize="14" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextForeground}"
                           Margin="20,20,20,14"/>

                <ListBox x:Name="CategoryList"
                         ItemsSource="{Binding Categories}"
                         SelectedItem="{Binding Selected, Mode=TwoWay}"
                         Background="Transparent"
                         BorderThickness="0"
                         HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="8,2"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Focusable" Value="True"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <!-- 模板对齐 SelectorWindow 的「未入网格」行：圆角、悬停高亮、选中蓝色 -->
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="RowBd"
                                                Padding="10,8"
                                                CornerRadius="4"
                                                Background="Transparent"
                                                BorderThickness="1"
                                                BorderBrush="Transparent">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="RowBd" Property="Background" Value="{DynamicResource HoverBackground}"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="RowBd" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                                <Setter TargetName="RowBd" Property="BorderBrush" Value="{DynamicResource AccentBrushLight}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Icon}"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="13"
                                           Foreground="{DynamicResource TextForeground}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,10,0"/>
                                <TextBlock Text="{Binding Title}"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextForeground}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- ===== 右列：详情面板 ===== -->
        <Border Grid.Column="1"
                Background="{DynamicResource PanelBackgroundDeep}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Padding="28,24">
                <Grid>
                    <!-- 主题面板 -->
                    <StackPanel Visibility="{Binding IsThemeSelected, Converter={StaticResource BoolToVis}}">
                        <TextBlock Style="{StaticResource PanelTitle}" Text="主题"/>

                        <Grid Style="{StaticResource FieldRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource FieldLabel}" Text="主题模式"/>
                            <ComboBox Grid.Column="1"
                                      Style="{StaticResource FieldComboBox}"
                                      SelectedItem="{Binding ThemeMode, Mode=TwoWay}"
                                      HorizontalAlignment="Stretch">
                                <ComboBox.ItemTemplate>
                                    <!-- Foreground 留空：闭合态继承 ComboBox，弹层里继承 ComboBoxItem
                                         （选中项会被模板触发器改成白色，蓝底白字） -->
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource ThemeModeToText}}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                                <models:ThemeMode>System</models:ThemeMode>
                                <models:ThemeMode>Light</models:ThemeMode>
                                <models:ThemeMode>Dark</models:ThemeMode>
                            </ComboBox>
                        </Grid>

                        <TextBlock Foreground="{DynamicResource TextForegroundMuted}"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,0"
                                   Text="「跟随系统主题」会读取 Windows 的深色/浅色设置，系统切换时自动跟随。"/>
                    </StackPanel>

                    <!-- 输入框聚焦面板 -->
                    <StackPanel Visibility="{Binding IsFocusSelected, Converter={StaticResource BoolToVis}}">
                        <TextBlock Style="{StaticResource PanelTitle}" Text="输入框聚焦"/>

                        <CheckBox Style="{StaticResource FieldCheck}"
                                  Content="切换程序后自动聚焦到该程序录制的输入框"
                                  IsChecked="{Binding FocusAfterSwitch, Mode=TwoWay}"
                                  Margin="0,0,0,8"/>

                        <TextBlock Foreground="{DynamicResource TextForegroundMuted}"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Text="录制后，每次切到该程序，键盘焦点会直接落到输入框上（浏览器地址栏、搜索框等）。对自绘界面（游戏）和以管理员运行的程序可能无效。"
                                   Margin="0,0,0,16"/>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Button Style="{StaticResource FieldButton}"
                                    Content="捕获输入框…"
                                    Click="OnCaptureFocusTarget"/>
                        </StackPanel>

                        <ListBox ItemsSource="{Binding FocusTargetRows}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 HorizontalContentAlignment="Stretch"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 Margin="0,0,0,8">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0,2"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Focusable" Value="False"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border Background="{DynamicResource CellBackground}"
                                                        CornerRadius="4"
                                                        Padding="12,8">
                                                    <ContentPresenter/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Process}"
                                                       FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextForeground}"/>
                                            <TextBlock FontSize="11"
                                                       Foreground="{DynamicResource TextForegroundDim}"
                                                       TextWrapping="Wrap">
                                                <Run Text="{Binding Description, Mode=OneWay}"/>
                                                <Run Text="{Binding CapturedAt, Mode=OneWay}"
                                                     Foreground="{DynamicResource TextForegroundMuted}"/>
                                            </TextBlock>
                                        </StackPanel>
                                        <Button Grid.Column="1"
                                                Style="{StaticResource FieldButton}"
                                                Content="删除"
                                                Padding="10,3"
                                                Command="{Binding Delete}"
                                                VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock Foreground="{DynamicResource TextForegroundMuted}"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Visibility="{Binding HasFocusTargets, Converter={StaticResource BoolToVis}, ConverterParameter=invert}"
                                   Text="还没有录制。点上方按钮后，在目标程序里点一下要聚焦的输入框即可（每个程序录一条，重复录制会覆盖）。"/>
                    </StackPanel>

                    <!-- 行为面板 -->
                    <StackPanel Visibility="{Binding IsBehaviorSelected, Converter={StaticResource BoolToVis}}">
                        <TextBlock Style="{StaticResource PanelTitle}" Text="行为"/>

                        <CheckBox Style="{StaticResource FieldCheck}"
                                  Content="选择器失焦时自动关闭"
                                  IsChecked="{Binding HideSelectorOnDeactivate, Mode=TwoWay}"
                                  Margin="0,0,0,8"/>

                        <TextBlock Foreground="{DynamicResource TextForegroundMuted}"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Text="关闭后，其他窗口抢走前台时选择器保持常驻，索引键照常可用（按键走全局钩子，不依赖窗口焦点）。如果你的应用（如 ZCode 等流式更新的应用）会抢前台，导致选择器刚弹出就被关闭、切换无法完成，请关闭此开关。"/>
                    </StackPanel>

                    <!-- 其他分类占位 -->
                    <StackPanel Visibility="{Binding IsGenericSelected, Converter={StaticResource BoolToVis}}">
                        <TextBlock Style="{StaticResource PanelTitle}"
                                   Text="{Binding Selected.Title}"/>
                        <TextBlock Foreground="{DynamicResource TextForegroundMuted}"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Text="该类别的详细设置面板将在后续版本中提供。"/>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>