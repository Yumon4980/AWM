<Window x:Class="AltTabReplacer.SelectorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AltTabReplacer"
        Title="AltTabReplacer"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        ShowActivated="True"
        Width="900" Height="600"
        PreviewKeyDown="OnWindowPreviewKeyDown">
    <Window.Resources>
        <local:CellSizeConverter x:Key="CellSize"/>
        <local:BoolToVisConverter x:Key="BoolToVis"/>

        <Style x:Key="MenuBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#FFDDDDDD"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 网格单元格：键标在左上、图标居中、名字在底部。空位显示暗色占位块。 -->
        <DataTemplate x:Key="GridCellTemplate">
            <Grid>
                <!-- 空占位：不可触发，只撑满网格、保留键位空间关系 -->
                <Border Background="#FF151515" CornerRadius="4"
                        Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}"/>

                <!-- 有内容的格 -->
                <Grid Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 容器色带：程序组蓝色、程序组合绿色 -->
                    <Border Grid.Row="0" Height="3" CornerRadius="1.5" HorizontalAlignment="Stretch"
                            Visibility="{Binding ContainerVisibility}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#FF0078D4"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCombination}" Value="True">
                                        <Setter Property="Background" Value="#FF4CC26A"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>

                    <!-- 图标区 -->
                    <Grid Grid.Row="1" VerticalAlignment="Center">
                        <!-- 程序：单个大图标 -->
                        <Image Source="{Binding Icon}" Width="30" Height="30"
                               Visibility="{Binding WindowVisibility}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <!-- 程序组 / 程序组合：2×2 图标网格 -->
                        <ItemsControl ItemsSource="{Binding Icons}"
                                      Visibility="{Binding ContainerVisibility}"
                                      Width="40" Height="40"
                                      HorizontalAlignment="Center" VerticalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="2" Columns="2"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Image Source="{Binding}" Width="17" Height="17"
                                           Margin="1" Stretch="Uniform"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>

                    <!-- 名字 -->
                    <TextBlock Grid.Row="2" Text="{Binding Name}"
                               Foreground="#FFDDDDDD" FontSize="11"
                               HorizontalAlignment="Center" VerticalAlignment="Bottom"
                               TextTrimming="CharacterEllipsis" MaxWidth="120"/>

                    <!-- 计数徽标 + 下一级箭头 + 锁定按钮（右上角） -->
                    <StackPanel Grid.Row="0" HorizontalAlignment="Right" VerticalAlignment="Top"
                                Orientation="Horizontal" Margin="2">
                        <TextBlock Text="{Binding CountBadge}" Foreground="#FF9ACBF0" FontSize="10"
                                   VerticalAlignment="Center" Margin="0,0,3,0"
                                   Visibility="{Binding ContainerVisibility}"/>
                        <TextBlock Text="›" Foreground="#FF9ACBF0" FontSize="13" FontWeight="Bold"
                                   VerticalAlignment="Center" Margin="0,0,2,0"
                                   Visibility="{Binding ArrowVisibility}"/>
                        <Border Background="Transparent" Padding="3,1" Margin="1" Cursor="Hand"
                                ToolTip="锁定：固定占住这个键位，排序/删除都不会移动它"
                                PreviewMouseLeftButtonUp="OnLockToggleClick">
                            <TextBlock Text="{Binding LockGlyph}" FontSize="11"/>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- 键标（左上角）：空格也显示，颜色更暗 -->
                <Border HorizontalAlignment="Left" VerticalAlignment="Top"
                        Background="#CC000000" CornerRadius="3" Padding="5,1" MinWidth="18" Margin="2">
                    <TextBlock Text="{Binding KeyLabel}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="White"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                        <Setter Property="Foreground" Value="#FF555555"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>
            </Grid>
        </DataTemplate>

        <!-- 溢出列表行：横向紧凑（无键位） -->
        <DataTemplate x:Key="OverflowRowTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="4"/>
                    <ColumnDefinition Width="28"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="3" CornerRadius="1.5"
                        Visibility="{Binding ContainerVisibility}" VerticalAlignment="Stretch" Margin="0,1">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#FF0078D4"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCombination}" Value="True">
                                    <Setter Property="Background" Value="#FF4CC26A"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>

                <Image Grid.Column="1" Width="18" Height="18" Source="{Binding Icon}"
                       Visibility="{Binding WindowVisibility}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <ItemsControl Grid.Column="1" ItemsSource="{Binding Icons}"
                              Visibility="{Binding ContainerVisibility}"
                              Width="22" Height="22"
                              HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="2" Columns="2"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Image Source="{Binding}" Width="9" Height="9" Margin="1" Stretch="Uniform"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Grid.Column="2" Text="{Binding Name}" Foreground="#FFDDDDDD" FontSize="11"
                           VerticalAlignment="Center" Margin="6,0,0,0" TextTrimming="CharacterEllipsis"/>

                <TextBlock Grid.Column="3" Text="{Binding CountBadge}" Foreground="#FF9ACBF0" FontSize="10"
                           VerticalAlignment="Center" Margin="4,0,2,0"
                           Visibility="{Binding ContainerVisibility}"/>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid x:Name="PART_Grid">
        <Border x:Name="PART_Root" CornerRadius="8" Background="#E6202020"
                KeyDown="OnKeyDown"
                PreviewMouseLeftButtonDown="OnPreviewMouseLeftButtonDown"
                PreviewMouseMove="OnPreviewMouseMove"
                PreviewMouseLeftButtonUp="OnPreviewMouseLeftButtonUp">
            <Grid Margin="12">
                <Grid.ColumnDefinitions>
                    <!-- 左侧：网格 + 未入网格列表；右侧：大预览 -->
                    <ColumnDefinition Width="0.64*" MinWidth="420"/>
                    <ColumnDefinition Width="0.36*"/>
                </Grid.ColumnDefinitions>

                <DockPanel Grid.Column="0" Margin="0,0,8,0">

                    <!-- 左上角：新建程序组 -->
                    <Border DockPanel.Dock="Top" HorizontalAlignment="Left" Margin="0,0,0,8"
                            Visibility="{Binding AddGroupVisibility}">
                        <Button x:Name="PART_AddGroup" Content="+ 新建程序组"
                                Style="{StaticResource MenuBtn}"
                                Click="OnAddGroupClick"
                                ToolTip="新建一个空程序组，再把程序/程序组合拖到它上面"
                                Background="#FF2A2A2A" Padding="10,5"/>
                    </Border>

                    <!-- 面包屑：只在二级/搜索时出现。也是"拖出该组"的落点 -->
                    <Border x:Name="PART_Breadcrumb" DockPanel.Dock="Top"
                            Visibility="{Binding BreadcrumbVisibility}"
                            CornerRadius="4" Padding="8,6" Margin="0,0,0,8"
                            Background="#FF262626"
                            BorderThickness="2" BorderBrush="Transparent">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding BreadcrumbIsDropTarget}" Value="True">
                                        <Setter Property="BorderBrush" Value="#FF0078D4"/>
                                        <Setter Property="Background" Value="#FF13314A"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="Esc 返回"
                                       Foreground="#FF777777" FontSize="11" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Breadcrumb}" Foreground="#FFDDDDDD"
                                       FontSize="12" FontWeight="SemiBold"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                    </Border>

                    <!-- 搜索框：只在搜索模式显示 -->
                    <Border DockPanel.Dock="Top" Background="#FF2A2A2A" CornerRadius="4"
                            Padding="8,6" Margin="0,0,0,8"
                            Visibility="{Binding SearchHintVisibility}">
                        <Grid>
                            <TextBlock Text="输入以筛选，Esc 退出搜索" Foreground="#FF888888" FontSize="12"
                                       IsHitTestVisible="False"
                                       VerticalAlignment="Center"
                                       x:Name="PART_SearchHint"/>
                            <TextBox x:Name="PART_SearchBox"
                                     Background="Transparent" BorderThickness="0"
                                     Foreground="White" FontSize="13"
                                     CaretBrush="White"
                                     TextChanged="OnSearchTextChanged"/>
                        </Grid>
                    </Border>

                    <!-- 底部操作提示 -->
                    <TextBlock DockPanel.Dock="Bottom" Margin="2,8,0,0"
                               Foreground="#FF666666" FontSize="10"
                               Text="1234/QWER/ASDF/ZXCV 选网格 · 方向键移动 · Enter 确认 · / 搜索 · Esc 返回 · 拖到格中=并入，拖到边缘=排序"/>

                    <!-- 未入网格列表 | 4×4 网格。DropLayer 覆盖两者，插入线定位转到共同祖先 PART_DropHost -->
                    <Grid x:Name="PART_DropHost">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 左侧：未入网格（溢出）列表（常驻） -->
                        <Border x:Name="PART_OverflowHost" Grid.Column="0" Width="190" Margin="0,0,8,0"
                                Background="#FF1A1A1A" CornerRadius="6" Padding="6">
                            <DockPanel>
                                <DockPanel DockPanel.Dock="Top" Margin="2,0,0,6">
                                    <Button x:Name="PART_AddOverflowGroup" Content="+" DockPanel.Dock="Right"
                                            Style="{StaticResource MenuBtn}" Padding="7,0" FontSize="14"
                                            Click="OnAddOverflowGroupClick"
                                            ToolTip="在未入网格区新建一个空程序组"/>
                                    <TextBlock Text="未入网格" Foreground="#FF888888" FontSize="11"
                                               VerticalAlignment="Center"/>
                                </DockPanel>
                                <ListBox x:Name="PART_Overflow"
                                         ItemsSource="{Binding Overflow}"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         KeyboardNavigation.DirectionalNavigation="None"
                                         MouseLeftButtonUp="OnMouseLeftButtonUp"
                                         PreviewMouseRightButtonUp="OnListPreviewMouseRightButtonUp"
                                         SelectionChanged="OnOverflowSelectionChanged">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="Padding" Value="0"/>
                                            <Setter Property="Margin" Value="0,1"/>
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            <Setter Property="Focusable" Value="False"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <Border x:Name="RowBorder" Padding="4,4" CornerRadius="4"
                                                                BorderThickness="2" BorderBrush="Transparent"
                                                                Background="Transparent">
                                                            <ContentPresenter/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="RowBorder" Property="Background" Value="#33FFFFFF"/>
                                                            </Trigger>
                                                            <Trigger Property="IsSelected" Value="True">
                                                                <Setter TargetName="RowBorder" Property="Background" Value="#FF0078D4"/>
                                                            </Trigger>
                                                            <DataTrigger Binding="{Binding IsDropTarget}" Value="True">
                                                                <Setter TargetName="RowBorder" Property="BorderBrush" Value="#FF4CC2FF"/>
                                                                <Setter TargetName="RowBorder" Property="Background" Value="#FF13314A"/>
                                                            </DataTrigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <StaticResource ResourceKey="OverflowRowTemplate"/>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                        </Border>

                        <!-- 中间：4×4 键位网格 -->
                        <Grid x:Name="PART_ListHost" Grid.Column="1">
                            <ListBox x:Name="PART_List"
                                     ItemsSource="{Binding Slots}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     KeyboardNavigation.DirectionalNavigation="None"
                                     MouseLeftButtonUp="OnMouseLeftButtonUp"
                                     PreviewMouseRightButtonUp="OnListPreviewMouseRightButtonUp"
                                     SelectionChanged="OnListSelectionChanged">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="4"/>
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="Margin" Value="2"/>
                                        <!-- 强制方形：高度跟随网格可用宽度 / 4（扣掉外边距） -->
                                        <Setter Property="Height" Value="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource CellSize}, ConverterParameter=4}"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Focusable" Value="False"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="RowBorder"
                                                            Padding="6,4"
                                                            CornerRadius="6"
                                                            BorderThickness="2"
                                                            BorderBrush="Transparent"
                                                            Background="#FF1C1C1C">
                                                        <ContentPresenter/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="RowBorder" Property="Background" Value="#FF2A2A2A"/>
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="RowBorder" Property="Background" Value="#FF0078D4"/>
                                                        </Trigger>
                                                        <DataTrigger Binding="{Binding IsDropTarget}" Value="True">
                                                            <Setter TargetName="RowBorder" Property="BorderBrush" Value="#FF4CC2FF"/>
                                                            <Setter TargetName="RowBorder" Property="Background" Value="#FF13314A"/>
                                                        </DataTrigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <!-- 空占位格不可触发（不接收鼠标，也不进选中） -->
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                                <Setter Property="IsHitTestVisible" Value="False"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <StaticResource ResourceKey="GridCellTemplate"/>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>

                        <!-- 排序插入线。IsHitTestVisible=False，不干扰拖动命中测试 -->
                        <Canvas x:Name="PART_DropLayer" Grid.ColumnSpan="2" IsHitTestVisible="False">
                            <Border x:Name="PART_InsertLine" Visibility="Collapsed"
                                    Background="#FF4CC2FF" CornerRadius="1"/>
                        </Canvas>
                    </Grid>
                </DockPanel>

                <!-- 右侧：实时预览当前选中窗口 -->
                <Border Grid.Column="1" Background="#FF101010" CornerRadius="6" ClipToBounds="True">
                    <Grid>
                        <Image x:Name="PART_PreviewImage"
                               Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock x:Name="PART_PreviewPlaceholder"
                                   Text="(no selection)"
                                   Foreground="#FF666666" FontSize="14"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   IsHitTestVisible="False"/>
                        <TextBlock x:Name="PART_PreviewTitle"
                                   Foreground="#FFCCCCCC" FontSize="13"
                                   HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                   Margin="0,0,0,12"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="500"
                                   IsHitTestVisible="False"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- 右键菜单：画在自己的可视树里，不用 ContextMenu/Popup -->
        <Border x:Name="PART_Menu"
                Visibility="Collapsed"
                HorizontalAlignment="Left" VerticalAlignment="Top"
                Background="#FF2A2A2A" BorderBrush="#FF0078D4" BorderThickness="1"
                CornerRadius="6" Padding="4" MinWidth="150">
            <Border.Effect>
                <DropShadowEffect BlurRadius="14" Opacity="0.75" ShadowDepth="3" Color="Black"/>
            </Border.Effect>
            <StackPanel>
                <Button x:Name="PART_MenuRename" Content="重命名…"
                        Style="{StaticResource MenuBtn}" Click="OnMenuRenameClick"/>
                <Button x:Name="PART_MenuClose" Content="关闭程序"
                        Style="{StaticResource MenuBtn}" Click="OnMenuCloseClick"/>
                <Button x:Name="PART_MenuDissolve" Content="删除程序组"
                        Style="{StaticResource MenuBtn}" Click="OnMenuDissolveClick"/>
                <Button x:Name="PART_MenuDissolveCombo" Content="解散程序组合"
                        Style="{StaticResource MenuBtn}" Click="OnMenuDissolveComboClick"/>
                <Button x:Name="PART_MenuRemove" Content="移出分组"
                        Style="{StaticResource MenuBtn}" Click="OnMenuRemoveClick"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
