<Window x:Class="AltTabReplacer.SelectorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AltTabReplacer"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        SizeToContent="WidthAndHeight"
        ShowActivated="True"
        FocusManager.FocusedElement="{Binding ElementName=PART_List}">
    <Grid x:Name="PART_Grid">
        <Border x:Name="PART_Root" CornerRadius="8" Padding="16" Background="#CC202020"
                KeyDown="OnKeyDown"
                PreviewMouseLeftButtonDown="OnPreviewMouseLeftButtonDown"
                PreviewMouseMove="OnPreviewMouseMove"
                PreviewMouseLeftButtonUp="OnPreviewMouseLeftButtonUp">
            <ListBox x:Name="PART_List"
                     ItemsSource="{Binding Cells}"
                     SelectedIndex="{Binding SelectedIndex, Mode=TwoWay}"
                     Background="Transparent"
                     BorderThickness="0"
                     HorizontalAlignment="Center"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Disabled"
                     KeyboardNavigation.DirectionalNavigation="None"
                     MouseLeftButtonUp="OnMouseLeftButtonUp">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="4"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                        <Setter Property="Focusable" Value="False"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="CellBorder"
                                            Width="256" Height="180"
                                            CornerRadius="4"
                                            BorderThickness="0"
                                            Background="#FF1A1A1A">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="30"/>
                                            </Grid.RowDefinitions>
                                            <Image Grid.Row="0" Source="{Binding Thumbnail}" Stretch="UniformToFill" Margin="0"/>
                                            <TextBlock Grid.Row="0" Text="(no preview)"
                                                       Foreground="#FF888888"
                                                       FontSize="11"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Thumbnail}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <Border Grid.Row="0" HorizontalAlignment="Left" VerticalAlignment="Top"
                                                    Margin="6,6,0,0"
                                                    Background="#CC000000" CornerRadius="3" Padding="5,1">
                                                <TextBlock Text="{Binding KeyLabel}" Foreground="White" FontSize="11" FontWeight="Bold"/>
                                            </Border>
                                            <TextBlock Grid.Row="1" Text="{Binding Title}"
                                                       Foreground="#FFDDDDDD"
                                                       FontSize="12"
                                                       VerticalAlignment="Center"
                                                       HorizontalAlignment="Left"
                                                       Margin="10,0,10,0"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="CellBorder" Property="BorderBrush" Value="#FF0078D4"/>
                                            <Setter TargetName="CellBorder" Property="BorderThickness" Value="2"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
        </Border>

        <!-- Ghost 拖动用独立 topmost 透明 Window（不是 Popup），Left/Top 接受屏幕坐标，中心精确对准鼠标 -->
        <!-- （代码动态创建 _ghostWindow 替代这里） -->
    </Grid>
</Window>
