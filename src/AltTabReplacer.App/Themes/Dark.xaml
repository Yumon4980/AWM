<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 深色主题：背景黑/灰，前景白，蓝色高亮。 -->

    <!-- 窗口 / 主面板背景 -->
    <SolidColorBrush x:Key="WindowBackground"     Color="#E6202020"/>
    <SolidColorBrush x:Key="PanelBackground"      Color="#FF1C1C1C"/>
    <SolidColorBrush x:Key="PanelBackgroundAlt"   Color="#FF252525"/>
    <SolidColorBrush x:Key="PanelBackgroundDeep"  Color="#FF151515"/>

    <!-- 前景文字 -->
    <SolidColorBrush x:Key="TextForeground"      Color="#FFDDDDDD"/>
    <SolidColorBrush x:Key="TextForegroundDim"   Color="#FF999999"/>
    <SolidColorBrush x:Key="TextForegroundMuted" Color="#FF666666"/>

    <!-- 强调色 / 高亮 -->
    <SolidColorBrush x:Key="AccentBrush"         Color="#FF0078D4"/>
    <SolidColorBrush x:Key="AccentBrushLight"    Color="#FF4CC2FF"/>
    <SolidColorBrush x:Key="DropTargetBackground" Color="#FF13314A"/>

    <!-- 边框 / 分隔线 -->
    <SolidColorBrush x:Key="BorderBrush"         Color="#FF333333"/>
    <SolidColorBrush x:Key="BorderBrushStrong"   Color="#FF444444"/>

    <!-- 控件专用 -->
    <SolidColorBrush x:Key="InputBackground"     Color="#FF1A1A1A"/>
    <SolidColorBrush x:Key="HoverBackground"     Color="#33FFFFFF"/>

    <!-- 选择器专用：网格 / 溢出 / 搜索 / 面包屑 / 预览面板 -->
    <SolidColorBrush x:Key="GroupAccentGreen"        Color="#FF4CC26A"/>
    <SolidColorBrush x:Key="CellBackground"           Color="#FF1C1C1C"/>
    <SolidColorBrush x:Key="CellBackgroundHover"      Color="#FF2A2A2A"/>
    <SolidColorBrush x:Key="EmptyCellBackground"      Color="#FF151515"/>
    <SolidColorBrush x:Key="OverflowPanelBackground"  Color="#FF1A1A1A"/>
    <SolidColorBrush x:Key="SearchPanelBackground"    Color="#FF2A2A2A"/>
    <SolidColorBrush x:Key="BreadcrumbBackground"     Color="#FF262626"/>
    <SolidColorBrush x:Key="PreviewPanelBackground"   Color="#FF101010"/>

    <!-- 选择器专用：文字色阶 -->
    <SolidColorBrush x:Key="KeyLabelForeground"       Color="#FFDDDDDD"/>
    <SolidColorBrush x:Key="KeyLabelForegroundEmpty"  Color="#FF555555"/>
    <SolidColorBrush x:Key="SubtleForeground"         Color="#FF888888"/>
    <SolidColorBrush x:Key="DimForeground"            Color="#FF777777"/>
    <SolidColorBrush x:Key="HintForeground"           Color="#FF666666"/>
    <SolidColorBrush x:Key="BadgeAccentForeground"    Color="#FF9ACBF0"/>
    <SolidColorBrush x:Key="BadgeMutedForeground"     Color="#FFBBBBBB"/>
    <SolidColorBrush x:Key="SelectionTitleForeground" Color="#FFCCCCCC"/>

    <!-- 选择器专用：键标徽章背景 / 右键菜单 / 拖动 ghost / 占位预览 -->
    <SolidColorBrush x:Key="BadgeBackground"          Color="#CC000000"/>
    <SolidColorBrush x:Key="MenuBorderBrush"          Color="#FF0078D4"/>
    <SolidColorBrush x:Key="GhostBorderBrush"         Color="#FF0078D4"/>
    <SolidColorBrush x:Key="GhostBackgroundBrush"     Color="#FF1E1E1E"/>
    <SolidColorBrush x:Key="GhostTextBrush"           Color="#FFDDDDDD"/>
    <SolidColorBrush x:Key="IconPreviewBackground"    Color="#FF101010"/>
    <SolidColorBrush x:Key="IconPreviewForeground"    Color="#FF888888"/>

</ResourceDictionary>